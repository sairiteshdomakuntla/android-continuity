{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "options": {
        "baseURL": "https://agentrouter.org/v1"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },

    "openai": {
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        }
      }
    }
  },

  "model": "agentrouter/glm-5.3"
}