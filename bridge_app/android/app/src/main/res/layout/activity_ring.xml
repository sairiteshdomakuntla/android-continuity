<?xml version="1.0" encoding="utf-8"?>
<!-- Ringing overlay — Clay+Linen first-class screen, not a system dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F4EEE3"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/ring_icon_tile">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_bell_clay" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Bridge is ringing"
        android:fontFamily="@font/fraunces"
        android:textSize="26sp"
        android:textColor="#2F2620" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your PC is looking for this phone"
        android:fontFamily="@font/nunito_sans"
        android:textSize="14sp"
        android:textColor="#6E6155" />

    <Button
        android:id="@+id/btn_stop_ring"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minWidth="200dp"
        android:text="Stop Ringing"
        android:fontFamily="@font/nunito_sans"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:textColor="#FDF8EF"
        android:background="@drawable/ring_stop_button"
        android:paddingStart="32dp"
        android:paddingEnd="32dp" />
</LinearLayout>
